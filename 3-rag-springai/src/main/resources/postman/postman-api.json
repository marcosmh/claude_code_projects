          "name": "2.1a Consulta: diferencia entre arbitraje y mediación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Tiene answer y sources', () => { pm.expect(b.answer).to.be.a('string').and.not.empty; pm.expect(b.sources).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Respuesta: { answer, sources:[{documentId,fileName,page,score,snippet}] }. Si no hay fragmentos relevantes, sources=[] y answer es un mensaje fijo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"que diferencia hay entre arbitraje y mediación?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/rag/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rag",
                "ask"
