# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portal_inmobiliario"

# Autenticación (generar con: openssl rand -base64 32)
AUTH_SECRET=""

# Cloudinary (solo servidor)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps (clave restringida por dominio, expuesta al navegador)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Web3Forms (solo servidor)
WEB3FORMS_ACCESS_KEY=""

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# pgAdmin (docker compose up -d pgadmin)
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="cambiar-esta-clave"
