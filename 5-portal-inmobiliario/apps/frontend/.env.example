# Copiar a .env.local y completar. Solo NEXT_PUBLIC_* llegan al navegador.

# URL del backend (la usa el proxy de Next.js; se evalúa al construir)
BACKEND_URL="http://localhost:4000"

# Google Maps (clave restringida por dominio)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
