# Copiar a .env.local y completar. No versionar secretos.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/portal_inmobiliario"

# Autenticación (generar con: openssl rand -base64 32)
AUTH_SECRET=""

# Cloudinary (solo servidor)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Web3Forms (solo servidor)
WEB3FORMS_ACCESS_KEY=""
