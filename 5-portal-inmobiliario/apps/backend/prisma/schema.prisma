generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PropertyOperation {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  OFFICE
  COMMERCIAL
  OTHER
}

enum PropertyAvailability {
  AVAILABLE
  SOLD
  RENTED
}

enum Currency {
  MXN
  USD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites Favorite[]
  inquiries Inquiry[]

  @@index([createdAt])
  @@map("users")
}

model Property {
  id           String               @id @default(cuid())
  title        String
  description  String
  operation    PropertyOperation
  type         PropertyType
  price        Decimal              @db.Decimal(14, 2)
  currency     Currency             @default(MXN)
  // Estado comercial: una propiedad publicada puede figurar como vendida o rentada.
  availability PropertyAvailability @default(AVAILABLE)

  // Campos opcionales: pueden no aplicar al tipo de propiedad (p. ej. terrenos).
  usableArea   Decimal? @db.Decimal(10, 2)
  totalArea    Decimal? @db.Decimal(10, 2)
  bedrooms     Int?
  bathrooms    Int?
  parkingSpots Int?
  age          Int?

  // Ubicación textual. No se almacenan latitud/longitud.
  address String
  commune String
  city    String
  region  String

  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Borrado lógico: no nulo = eliminada por un administrador (no se borra ninguna fila).
  deletedAt   DateTime?

  images    PropertyImage[]
  features  Feature[]
  favorites Favorite[]
  inquiries Inquiry[]

  @@index([isPublished, operation, type])
  @@index([isPublished, createdAt])
  @@index([isPublished, availability])
  @@index([isPublished, isFeatured])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([price])
  @@index([commune])
  @@index([city])
  @@index([region])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String   @unique
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_images")
}

model Feature {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  properties Property[]

  @@map("features")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

model Inquiry {
  id         String   @id @default(cuid())
  propertyId String
  // Nulo para consultas de visitantes no autenticados.
  userId     String?
  name       String
  email      String
  phone      String?
  message    String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("inquiries")
}
