# Copia este archivo a .env (ignorado por git) y rellena los valores. Nunca subas credenciales al repositorio.
# Supabase: Project Settings > Database > Connection string (Session pooler, puerto 5432), en formato JDBC.
DB_URL=jdbc:postgresql://<host-del-pooler>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<contraseña-de-la-base-de-datos>
DB_SCHEMA=chat
# Opcionales
# DB_POOL_SIZE=5
# DDL_AUTO=update
