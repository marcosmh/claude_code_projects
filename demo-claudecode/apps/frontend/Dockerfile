# Build context: the monorepo root (demo-claudecode/).
#   docker build -f apps/frontend/Dockerfile -t invoices-frontend .
# Serves the SPA and proxies /api to BACKEND_UPSTREAM, so browser and API share one origin (cookies stay first-party).
#   docker run -p 8080:8080 -e BACKEND_UPSTREAM=http://backend:4000 invoices-frontend

FROM node:22-bookworm-slim AS prune
WORKDIR /repo
RUN npm install --global turbo@^2
COPY . .
RUN turbo prune @invoices/frontend --docker

FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY --from=prune /repo/out/json/ .
COPY --from=prune /repo/out/package-lock.json ./package-lock.json
RUN npm ci
COPY --from=prune /repo/out/full/ .
# `turbo prune` leaves out the root tsconfig that every package extends.
COPY tsconfig.base.json ./
# Relative API URL = same origin; the CSP's connect-src then stays 'self'. Override to host the API elsewhere.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npx turbo run build --filter=@invoices/frontend

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime
COPY --from=build /repo/apps/frontend/dist /usr/share/nginx/html
# `security-headers.conf` is generated by the build from the same CSP as the <meta> tag.
COPY --from=build /repo/apps/frontend/dist/security-headers.conf /etc/nginx/security-headers.conf
COPY apps/frontend/deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_UPSTREAM=http://backend:4000
EXPOSE 8080
