# Rendered by the nginx image at start: only ${BACKEND_UPSTREAM} is substituted; nginx variables are left alone.
# add_header in a location replaces the ones inherited from the server block, so the include is repeated.
server {
  listen 8080;
  root /usr/share/nginx/html;

  # The API. Keep the original path (no URI in proxy_pass) and tell the backend who is really calling:
  # set TRUSTED_PROXY_HOPS=1 there so the rate limiter reads X-Forwarded-For.
  location /api/ {
    proxy_pass ${BACKEND_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # Hashed build assets never change under the same name.
  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: any other path serves index.html, which must always be revalidated.
  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
