generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  // scrypt$N$r$p$salt$hash (see src/utils/password.ts)
  passwordHash  String
  // Consecutive failed logins; reset on success and when the account gets locked
  failedLogins  Int            @default(0)
  // While in the future the account rejects every login, even with the right password
  lockedUntil   DateTime?      @db.Timestamptz(3)
  // USER | ADMIN (validated in the service layer, not a Prisma enum)
  role          String         @default("USER")
  // Embedded in access tokens (`ver`); bumping it invalidates every live access token of the user
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  refreshTokens RefreshToken[]
  invoices      Invoice[]
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  // SHA-256 of the refresh token's jti; the raw value is never stored
  tokenHash  String    @unique
  // Shared by every token born from the same login; reuse of a rotated token revokes the whole family
  family     String
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @db.Timestamptz(3)
  // Set when the token is rotated, logged out or revoked
  revokedAt  DateTime? @db.Timestamptz(3)
  // Id of the RefreshToken row that replaced this one on rotation (plain column, no FK: rows may be purged independently)
  replacedBy Int?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  // Matches the queries: family liveness / revocation, per-user revocation, purge of expired rows
  @@index([family, revokedAt, expiresAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  // Nullable only for invoices that predate authentication; they are claimed by the first user created
  ownerId       Int?
  owner         User?         @relation(fields: [ownerId], references: [id])
  number        String        @unique
  clientName    String
  clientEmail   String?
  clientAddress String?
  issueDate     DateTime      @db.Timestamptz(3)
  dueDate       DateTime      @db.Timestamptz(3)
  // DRAFT | SENT | PAID (validated in the service layer, not a Prisma enum)
  status        String        @default("DRAFT")
  taxRate       Float         @default(0)
  // MXN | USD | EUR (validated in the service layer, not a Prisma enum); invoices that predate the column are USD
  currency      String        @default("USD")
  notes         String?
  items         InvoiceItem[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  // Every query filters by owner first: list order (issueDate desc, id desc), status filter and stats window.
  // `dueDate` is never queried (overdue is computed in memory), so it has no index.
  @@index([ownerId, issueDate(sort: Desc), id(sort: Desc)])
  @@index([ownerId, status])
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  // Money as integer cents
  unitPriceCents Int

  @@index([invoiceId])
}

// Security trail (logins, lockouts, refresh reuse, password changes): see src/utils/audit.ts. No relation to User on
// purpose: the trail must outlive the account. Never stores passwords, tokens, emails or IPs.
model AuditEvent {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int?
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}
