generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  // scrypt$N$r$p$salt$hash (see src/utils/password.ts)
  passwordHash  String
  // Consecutive failed logins; reset on success and when the account gets locked
  failedLogins  Int            @default(0)
  // While in the future the account rejects every login, even with the right password
  lockedUntil   DateTime?
  // USER | ADMIN (validated in the service layer, not a Prisma enum)
  role          String         @default("USER")
  // Embedded in access tokens (`ver`); bumping it invalidates every live access token of the user
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  sessions      Session[]
  refreshTokens RefreshToken[]
  invoices      Invoice[]
}

model Session {
  id        Int      @id @default(autoincrement())
  // SHA-256 of the opaque token held in the httpOnly cookie; the raw token is never stored
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  // SHA-256 of the refresh token's jti; the raw value is never stored
  tokenHash  String    @unique
  // Shared by every token born from the same login; reuse of a rotated token revokes the whole family
  family     String
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  // Set when the token is rotated, logged out or revoked
  revokedAt  DateTime?
  // Id of the RefreshToken row that replaced this one on rotation (plain column, no FK: rows may be purged independently)
  replacedBy Int?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  // Nullable only for invoices that predate authentication; they are claimed by the first user created
  ownerId       Int?
  owner         User?         @relation(fields: [ownerId], references: [id])
  number        String        @unique
  clientName    String
  clientEmail   String?
  clientAddress String?
  issueDate     DateTime
  dueDate       DateTime
  // DRAFT | SENT | PAID (validated in the service layer, not a Prisma enum)
  status        String        @default("DRAFT")
  taxRate       Float         @default(0)
  notes         String?
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  // Money as integer cents
  unitPriceCents Int

  @@index([invoiceId])
}
