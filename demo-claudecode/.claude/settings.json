{
  "hooks": {},
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npx prisma *)",
      "Bash(git commit *)",
      "Bash(git * main)",
      "Bash(git * master)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
