#!/usr/bin/env bash
# Stops the processes started by scripts/start_apps (kills each whole process group).
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN="$ROOT/scripts/.run"

for name in backend frontend; do
  pidfile="$RUN/$name.pid"
  if [[ ! -f "$pidfile" ]]; then echo "$name: no iniciado con start_apps"; continue; fi
  pid=$(cat "$pidfile")
  if kill -0 "$pid" 2>/dev/null; then
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    kill -0 "$pid" 2>/dev/null && { kill -9 -- "-$pid" 2>/dev/null; echo "$name forzado (SIGKILL)"; } || echo "$name detenido"
  else
    echo "$name: el proceso $pid ya no existía"
  fi
  rm -f "$pidfile"
done
